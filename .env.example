# Copy to .env and fill in. Never commit real values.

# NASA API key (https://api.nasa.gov). Read SERVER-SIDE only via process.env.
# If empty, the server falls back to NASA's public DEMO_KEY (heavily rate-limited).
NASA_API_KEY=your_nasa_api_key_here

# Backend (publishable values only — safe for the browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
VITE_SUPABASE_PROJECT_ID=your_project_id_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Server-only. Used for the nasa_cache table. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
